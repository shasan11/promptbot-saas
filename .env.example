APP_NAME=PromptBot
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost
CENTRAL_DOMAINS=localhost,127.0.0.1
TENANT_BASE_DOMAIN=localhost
CORS_ALLOWED_ORIGINS=http://localhost,http://localhost:8000,http://localhost:5173,http://127.0.0.1:8000,http://127.0.0.1:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=central
DB_DRIVER=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=promptbot_central
DB_USERNAME=root
DB_PASSWORD=

TENANT_DB_PROVISIONING_MODE=manual
TENANT_DATABASE_PREFIX=tenant_
TENANT_DB_DRIVER=mysql
TENANT_DB_HOST="${DB_HOST}"
TENANT_DB_PORT="${DB_PORT}"
TENANT_DB_USERNAME="${DB_USERNAME}"
TENANT_DB_PASSWORD="${DB_PASSWORD}"
ALLOW_TENANT_DATABASE_DELETION=false

CPANEL_HOST=
CPANEL_USERNAME=
CPANEL_API_TOKEN=
CPANEL_DATABASE_PREFIX=
CPANEL_DATABASE_USER=
CPANEL_VERIFY_SSL=true

TENANT_DB_ADMIN_DRIVER=mysql
TENANT_DB_ADMIN_HOST=
TENANT_DB_ADMIN_PORT=3306
TENANT_DB_ADMIN_DATABASE=mysql
TENANT_DB_ADMIN_USERNAME=
TENANT_DB_ADMIN_PASSWORD=

CENTRAL_ADMIN_NAME="Super Administrator"
CENTRAL_ADMIN_EMAIL=admin@example.com
CENTRAL_ADMIN_PASSWORD=
INSTALLER_LICENSE_VALIDATION_ENABLED=false
INSTALLER_LICENSE_VALIDATION_ENDPOINT=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
DEMO_MODE=false
DEMO_TENANT_IDS=
PROMPTBOT_SUPPORT_URL=
PROMPTBOT_DOCS_URL=

# Tenant AI runtime. Provider API keys are configured per workspace and are
# encrypted in the tenant database; never place tenant credentials here.
AI_ENABLED=true
AI_QUEUE_HIGH=ai-high
AI_QUEUE=ai-default
AI_ANALYSIS_QUEUE=ai-analysis
AI_EVALUATION_QUEUE=ai-evaluation
AI_QUEUE_LOW=ai-low
AI_DEFAULT_TIMEOUT=45
AI_MAX_RETRIES=2
AI_LOG_RETENTION_DAYS=90
# Keep false for hosted deployments. Enabling it permits tenant-configured
# Ollama endpoints on private networks and must be an intentional operator choice.
AI_ALLOW_PRIVATE_PROVIDER_ENDPOINTS=false
# Global emergency gate. Workspace, plan, Agent, channel, grounding, guardrail,
# provider health, approval, and budget gates still apply when this is true.
AI_AUTONOMOUS_REPLIES_ENABLED=false
# Optional local-only real provider used by AIDemoSeeder. Leave blank in hosted environments.
AI_DEMO_OLLAMA_URL=
AI_DEMO_OLLAMA_CHAT_MODEL=gemma3:4b
AI_DEMO_OLLAMA_EMBEDDING_MODEL=nomic-embed-text:latest
INSPECTOR_INGESTION_KEY=
KNOWLEDGE_AI_EMBEDDING_DIMENSIONS=1024
